# Debug mode (True/False)
DEBUG=False

# GUI server settings
GUI_HOST=0.0.0.0
GUI_PORT=9876

# MQTT broker settings
MQTT_BROKER=localhost
MQTT_PORT=1883
MQTT_USERNAME=your_username
MQTT_PASSWORD=your_password
MQTT_KEEPALIVE=60
MQTT_VERSION=3.1.1

# Device identifier
DEVICE_ID=your_device_id

# Secret key for Flask sessions
SECRET_KEY=your_secret_key

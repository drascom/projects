# Ollama Request Interceptor Client Configuration

# Server hostname or IP address
# Required: The hostname or IP address of the server running the interceptor
# Example: interceptor.example.com or 192.168.1.100
SERVER_HOST=

# Web UI port on the server
# Default: 8081
SERVER_WEB_UI_PORT=8081

# Authentication credentials (if enabled on server)
# Leave empty if authentication is not enabled on the server
AUTH_USERNAME=
AUTH_PASSWORD=

# Local port for SSH tunnel
# This is the local port that will be forwarded to the server's web UI
# Default: 8082
LOCAL_PORT=8082

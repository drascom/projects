# Ollama Request Interceptor Configuration

# Target URL for the Ollama API server
TARGET_URL=http://localhost:11434

# Port to run the interceptor on
INTERCEPT_PORT=8080

# Web UI port for mitmweb interface
WEB_UI_PORT=8081

# Mode (local, server, client)
MODE=local

# Authentication settings (for server mode)
ENABLE_AUTH=false
AUTH_USERNAME=your_username
AUTH_PASSWORD=your_password

# Server host (for client mode)
SERVER_HOST=your_server_hostname_or_ip

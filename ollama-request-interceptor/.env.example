# Ollama Request Interceptor Configuration

# Target URL for the Ollama API server
# Default: http://localhost:11434
TARGET_URL=http://localhost:11434

# Port to run the interceptor on
# Default: 8080
INTERCEPT_PORT=8080

# Web UI port for mitmweb interface
# Default: 8081
WEB_UI_PORT=8081

# === Remote Access Configuration ===
# Enable authentication for remote access (true/false)
# Default: false
ENABLE_AUTH=false

# Username for web UI authentication
# Only used when ENABLE_AUTH=true
AUTH_USERNAME=admin

# Password for web UI authentication
# Only used when ENABLE_AUTH=true
AUTH_PASSWORD=changeme

# Allow remote connections to web UI (true/false)
# If false, web UI is only accessible from localhost
# Default: false
ALLOW_REMOTE=false

# Server hostname or IP address for client connections
# Only needed when setting up a client to connect to a remote server
# Example: interceptor.example.com or 192.168.1.100
SERVER_HOST=